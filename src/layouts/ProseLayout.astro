---
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import BaseLayout from './BaseLayout.astro';

interface Frontmatter {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <div class="container prose-page">
    <Breadcrumbs
      items={[
        { label: 'Beranda', href: '/' },
        { label: frontmatter.title },
      ]}
    />

    <header class="prose-header">
      <p class="eyebrow">{frontmatter.eyebrow ?? 'Tentang'}</p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="lede">{frontmatter.description}</p>}
    </header>

    <article class="prose">
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .prose-page {
    padding-top: var(--space-8);
  }

  .prose-header {
    display: grid;
    gap: var(--space-4);
    max-width: var(--reading-width);
    padding-block: var(--space-10) var(--space-8);
  }

  .prose-header h1 {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    letter-spacing: -0.035em;
  }

  .prose-page :global(.prose) {
    padding-bottom: var(--space-16);
  }
</style>
