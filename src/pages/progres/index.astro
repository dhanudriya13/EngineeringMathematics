---
import ProgressDashboard from '../../components/progress/ProgressDashboard';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Progres Belajar"
  description="Ringkasan modul selesai, latihan, dan kuis yang tersimpan secara lokal di peramban."
>
  <div class="container progress-page">
    <Breadcrumbs
      items={[
        { label: 'Beranda', href: '/' },
        { label: 'Progres Belajar' },
      ]}
    />

    <header class="page-header">
      <p class="eyebrow">Rekam belajar lokal</p>
      <h1>Progres belajar.</h1>
      <p class="lede">
        Lihat modul yang telah ditandai selesai, jumlah latihan yang dikerjakan, dan riwayat skor
        kuis. Semua data disimpan di peramban ini tanpa akun dan tanpa server.
      </p>
      <p class="page-note">
        Progres bersifat spesifik per perangkat dan peramban. Data tidak disinkronkan antardevice,
        dan Local Storage dapat dihapus kapan saja melalui pengaturan peramban.
      </p>
    </header>

    <noscript>
      <div class="noscript-note">
        Halaman progres membutuhkan JavaScript untuk membaca Local Storage. Materi dan kuis tetap
        dapat diakses, tetapi ringkasan progres tidak dapat ditampilkan.
      </div>
    </noscript>

    <ProgressDashboard client:load />
  </div>
</BaseLayout>

<style>
  .progress-page {
    padding-top: var(--space-8);
  }

  .page-header {
    display: grid;
    gap: var(--space-4);
    max-width: 860px;
    padding-block: var(--space-10) var(--space-8);
  }

  .page-header h1 {
    font-size: clamp(2.25rem, 4vw, 3.35rem);
    letter-spacing: -0.04em;
  }

  .page-note {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .noscript-note {
    margin-bottom: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border: 1px solid #fde68a;
    border-radius: var(--radius-md);
    background: var(--color-warning-soft);
    color: #713f12;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
</style>
