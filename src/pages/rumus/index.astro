---
import Formula from '../../components/mathematics/Formula.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import { curriculumModules } from '../../data/curriculum';
import { formulaTopics, formulas } from '../../data/formulas';
import BaseLayout from '../../layouts/BaseLayout.astro';

const modulesById = new Map(
  curriculumModules.map((module) => [module.id, module]),
);

const groups = formulaTopics.map((topic) => ({
  topic,
  items: formulas.filter((formula) => formula.topic === topic),
}));

function getModule(moduleId: string) {
  return modulesById.get(moduleId);
}

function getSearchText(formula: (typeof formulas)[number]): string {
  const module = getModule(formula.moduleId);

  return [
    formula.name,
    formula.topic,
    formula.explanation,
    formula.example,
    module?.title ?? '',
    ...formula.variables.flatMap((variable) => [variable.symbol, variable.meaning]),
  ]
    .join(' ')
    .toLowerCase();
}
---

<BaseLayout
  title="Referensi Rumus"
  description="Kumpulan rumus vektor dengan penjelasan simbol, keterkaitan modul, dan contoh penerapan."
>
  <div class="container reference-page">
    <Breadcrumbs
      items={[
        { label: 'Beranda', href: '/' },
        { label: 'Referensi Rumus' },
      ]}
    />

    <header class="reference-header">
      <p class="eyebrow">Referensi matematika</p>
      <h1>Referensi rumus vektor.</h1>
      <p class="lede">
        Setiap rumus disertai arti simbol, penjelasan singkat, contoh, dan tautan ke modul tempat
        konsep tersebut dibahas. Gunakan pencarian untuk menemukan rumus berdasarkan nama, topik,
        atau variabel.
      </p>

      <div class="search-panel" data-formula-search hidden>
        <div class="search-field">
          <label for="formula-search">Cari rumus</label>
          <input
            id="formula-search"
            type="search"
            placeholder="Contoh: proyeksi, magnitudo, vektor satuan"
            autocomplete="off"
            data-formula-input
          />
        </div>
        <div class="search-field search-field--topic">
          <label for="formula-topic">Topik</label>
          <select id="formula-topic" data-formula-topic>
            <option value="all">Semua topik</option>
            {formulaTopics.map((topic) => <option value={topic}>{topic}</option>)}
          </select>
        </div>
        <button type="button" class="reset-button" data-formula-reset>Bersihkan</button>
      </div>
    </header>

    <p class="result-status" id="formula-status" aria-live="polite">
      {formulas.length} rumus tersedia
    </p>

    <div class="formula-groups">
      {
        groups.map((group) => {
          const groupId = `formula-group-${group.topic.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

          return (
            <section class="formula-group" data-formula-group aria-labelledby={groupId}>
              <h2 id={groupId}>{group.topic}</h2>
              <div class="formula-list">
                {group.items.map((formula) => {
                  const module = getModule(formula.moduleId);

                  return (
                    <article
                      class="formula-card"
                      data-formula-card
                      data-topic={formula.topic}
                      data-search={getSearchText(formula)}
                    >
                      <div class="formula-head">
                        <h3>{formula.name}</h3>
                        {module && (
                          <a class="module-link" href={`/materi/${module.id}`}>
                            Modul {String(module.number).padStart(2, '0')} · {module.title}
                          </a>
                        )}
                      </div>

                      <Formula tex={formula.expression} display />

                      <p class="formula-explanation">{formula.explanation}</p>

                      <div class="formula-variables">
                        <h4>Keterangan simbol</h4>
                        <dl>
                          {formula.variables.map((variable) => (
                            <div>
                              <dt><Formula tex={variable.symbol} /></dt>
                              <dd>{variable.meaning}</dd>
                            </div>
                          ))}
                        </dl>
                      </div>

                      <p class="formula-example">
                        <strong>Contoh:</strong> {formula.example}
                      </p>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })
      }
    </div>

    <p class="empty-state" id="formula-empty" hidden>
      Tidak ada rumus yang cocok dengan pencarian. Coba kata kunci yang lebih singkat atau pilih
      topik lain.
    </p>
  </div>
</BaseLayout>

<script>
  const panel = document.querySelector('[data-formula-search]');
  const input = document.querySelector('[data-formula-input]');
  const topic = document.querySelector('[data-formula-topic]');
  const reset = document.querySelector('[data-formula-reset]');
  const status = document.getElementById('formula-status');
  const empty = document.getElementById('formula-empty');

  if (
    panel &&
    input instanceof HTMLInputElement &&
    topic instanceof HTMLSelectElement &&
    reset instanceof HTMLButtonElement
  ) {
    panel.removeAttribute('hidden');

    const cards = Array.from(document.querySelectorAll('[data-formula-card]'));
    const groups = Array.from(document.querySelectorAll('[data-formula-group]'));

    const update = () => {
      const query = input.value.trim().toLowerCase();
      const selectedTopic = topic.value;
      let visible = 0;

      for (const card of cards) {
        const searchText = card.getAttribute('data-search') ?? '';
        const cardTopic = card.getAttribute('data-topic') ?? '';
        const matches =
          (selectedTopic === 'all' || cardTopic === selectedTopic) &&
          (query === '' || searchText.includes(query));

        card.toggleAttribute('hidden', !matches);

        if (matches) {
          visible += 1;
        }
      }

      for (const group of groups) {
        const hasVisibleCard = Array.from(
          group.querySelectorAll('[data-formula-card]'),
        ).some((card) => !card.hasAttribute('hidden'));
        group.toggleAttribute('hidden', !hasVisibleCard);
      }

      if (status) {
        status.textContent = `${visible} dari ${cards.length} rumus ditampilkan`;
      }

      if (empty) {
        empty.toggleAttribute('hidden', visible !== 0);
      }
    };

    input.addEventListener('input', update);
    topic.addEventListener('change', update);

    reset.addEventListener('click', () => {
      input.value = '';
      topic.value = 'all';
      update();
      input.focus();
    });

    update();
  }
</script>

<style>
  .reference-page {
    padding-top: var(--space-8);
  }

  .reference-header {
    display: grid;
    gap: var(--space-4);
    max-width: 880px;
    padding-block: var(--space-10) var(--space-8);
  }

  .reference-header h1 {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    letter-spacing: -0.04em;
  }

  .search-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px auto;
    align-items: end;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .search-field {
    display: grid;
    gap: 6px;
  }

  .search-field label {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search-field input,
  .search-field select {
    width: 100%;
    min-height: 42px;
    padding: 8px 12px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .search-field input:focus,
  .search-field select:focus {
    border-color: var(--color-accent);
  }

  .reset-button {
    min-height: 42px;
    padding: 8px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .reset-button:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .result-status {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .formula-groups {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-6) var(--space-16);
  }

  .formula-group h2 {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-primary);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .formula-list {
    display: grid;
    gap: var(--space-4);
    max-width: 920px;
  }

  .formula-card {
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .formula-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .formula-head h3 {
    font-size: var(--text-lg);
  }

  .module-link {
    flex: none;
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    text-decoration: none;
    white-space: nowrap;
  }

  .module-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .formula-card :global(.formula) {
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted);
    padding: var(--space-4) var(--space-5);
  }

  .formula-card :global(.formula figcaption) {
    text-align: left;
  }

  .formula-explanation {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .formula-variables {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .formula-variables h4 {
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .formula-variables dl {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .formula-variables dl > div {
    display: grid;
    grid-template-columns: minmax(120px, 190px) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
  }

  .formula-variables dt {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .formula-variables dd {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .formula-example {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .formula-example strong {
    color: var(--color-primary);
  }

  .empty-state {
    max-width: 680px;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 860px) {
    .search-panel {
      grid-template-columns: 1fr;
    }

    .formula-head {
      flex-direction: column;
    }

    .module-link {
      white-space: normal;
    }
  }

  @media (max-width: 620px) {
    .formula-card {
      padding: var(--space-4);
    }

    .formula-variables dl > div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
