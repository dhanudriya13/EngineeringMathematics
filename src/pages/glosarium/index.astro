---
import Formula from '../../components/mathematics/Formula.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import { curriculumModules } from '../../data/curriculum';
import { glossary } from '../../data/glossary';
import BaseLayout from '../../layouts/BaseLayout.astro';

const modulesById = new Map(curriculumModules.map((module) => [module.id, module]));
const sortedEntries = [...glossary].sort((a, b) => a.term.localeCompare(b.term, 'id'));
const letters = [...new Set(sortedEntries.map((entry) => entry.term.charAt(0).toUpperCase()))];

const groups = letters.map((letter) => ({
  letter,
  items: sortedEntries.filter((entry) => entry.term.charAt(0).toUpperCase() === letter),
}));

function getModule(moduleId: string) {
  return modulesById.get(moduleId);
}

function getSearchText(entry: (typeof glossary)[number]): string {
  const module = getModule(entry.moduleId);

  return [entry.term, entry.english, entry.definition, module?.title ?? '']
    .join(' ')
    .toLowerCase();
}

function getAnchor(letter: string): string {
  return `huruf-${letter.toLowerCase()}`;
}
---

<BaseLayout
  title="Glosarium"
  description="Istilah vektor dalam Bahasa Indonesia beserta padanan bahasa Inggris, definisi, rumus, dan modul terkait."
>
  <div class="container glossary-page">
    <Breadcrumbs
      items={[
        { label: 'Beranda', href: '/' },
        { label: 'Glosarium' },
      ]}
    />

    <header class="glossary-header">
      <p class="eyebrow">Istilah matematika</p>
      <h1>Glosarium vektor.</h1>
      <p class="lede">
        Daftar istilah yang digunakan sepanjang kurikulum, lengkap dengan padanan bahasa Inggris
        dan tautan ke modul pembahasan. Pencarian mencakup istilah, definisi, dan padanan Inggris.
      </p>

      <div class="search-panel" data-glossary-search hidden>
        <div class="search-field">
          <label for="glossary-search">Cari istilah</label>
          <input
            id="glossary-search"
            type="search"
            placeholder="Contoh: basis, ortogonal, proyeksi"
            autocomplete="off"
            data-glossary-input
          />
        </div>
        <button type="button" class="reset-button" data-glossary-reset>Bersihkan</button>
      </div>
    </header>

    <nav class="letter-nav" aria-label="Navigasi huruf">
      {
        letters.map((letter) => (
          <a href={`#${getAnchor(letter)}`} data-letter-link={letter}>
            {letter}
          </a>
        ))
      }
    </nav>

    <p class="result-status" id="glossary-status" aria-live="polite">
      {glossary.length} istilah tersedia
    </p>

    <div class="glossary-groups">
      {
        groups.map((group) => (
          <section
            class="glossary-group"
            data-glossary-group
            aria-labelledby={getAnchor(group.letter)}
          >
            <h2 id={getAnchor(group.letter)}>{group.letter}</h2>
            <div class="glossary-grid">
              {group.items.map((entry) => {
                const module = getModule(entry.moduleId);

                return (
                  <article
                    class="glossary-card"
                    data-glossary-card
                    data-search={getSearchText(entry)}
                  >
                    <div class="term-head">
                      <h3>{entry.term}</h3>
                      <span class="term-english">{entry.english}</span>
                    </div>
                    <p class="term-definition">{entry.definition}</p>
                    {entry.formula && (
                      <div class="term-formula">
                        <Formula tex={entry.formula} display />
                      </div>
                    )}
                    {module && (
                      <a class="term-module" href={`/materi/${module.id}`}>
                        Modul {String(module.number).padStart(2, '0')} · {module.title}
                      </a>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>

    <p class="empty-state" id="glossary-empty" hidden>
      Tidak ada istilah yang cocok dengan pencarian. Coba kata kunci lain atau gunakan istilah
      bahasa Inggris.
    </p>
  </div>
</BaseLayout>

<script>
  const panel = document.querySelector('[data-glossary-search]');
  const input = document.querySelector('[data-glossary-input]');
  const reset = document.querySelector('[data-glossary-reset]');
  const status = document.getElementById('glossary-status');
  const empty = document.getElementById('glossary-empty');

  if (panel && input instanceof HTMLInputElement && reset instanceof HTMLButtonElement) {
    panel.removeAttribute('hidden');

    const cards = Array.from(document.querySelectorAll('[data-glossary-card]'));
    const groups = Array.from(document.querySelectorAll('[data-glossary-group]'));
    const letterLinks = Array.from(document.querySelectorAll('[data-letter-link]'));

    const update = () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const searchText = card.getAttribute('data-search') ?? '';
        const matches = query === '' || searchText.includes(query);
        card.toggleAttribute('hidden', !matches);

        if (matches) {
          visible += 1;
        }
      }

      for (const group of groups) {
        const hasVisibleCard = Array.from(
          group.querySelectorAll('[data-glossary-card]'),
        ).some((card) => !card.hasAttribute('hidden'));
        group.toggleAttribute('hidden', !hasVisibleCard);

        const letter = group.querySelector('h2')?.textContent ?? '';
        const link = letterLinks.find(
          (item) => item.getAttribute('data-letter-link') === letter,
        );

        if (link) {
          link.toggleAttribute('hidden', !hasVisibleCard);
        }
      }

      if (status) {
        status.textContent = `${visible} dari ${cards.length} istilah ditampilkan`;
      }

      if (empty) {
        empty.toggleAttribute('hidden', visible !== 0);
      }
    };

    input.addEventListener('input', update);

    reset.addEventListener('click', () => {
      input.value = '';
      update();
      input.focus();
    });

    update();
  }
</script>

<style>
  .glossary-page {
    padding-top: var(--space-8);
  }

  .glossary-header {
    display: grid;
    gap: var(--space-4);
    max-width: 860px;
    padding-block: var(--space-10) var(--space-6);
  }

  .glossary-header h1 {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    letter-spacing: -0.04em;
  }

  .search-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .search-field {
    display: grid;
    gap: 6px;
  }

  .search-field label {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search-field input {
    width: 100%;
    min-height: 42px;
    padding: 8px 12px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .search-field input:focus {
    border-color: var(--color-accent);
  }

  .reset-button {
    min-height: 42px;
    padding: 8px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .reset-button:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .letter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
  }

  .letter-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    min-height: 32px;
    border-radius: var(--radius-sm);
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 650;
    text-decoration: none;
  }

  .letter-nav a:hover {
    background: var(--color-primary-soft);
  }

  .result-status {
    margin-top: var(--space-5);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .glossary-groups {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-5) var(--space-16);
  }

  .glossary-group {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .glossary-group h2 {
    padding-top: 2px;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 650;
  }

  .glossary-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .glossary-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .term-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .term-head h3 {
    font-size: var(--text-base);
    letter-spacing: -0.01em;
  }

  .term-english {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .term-definition {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .term-formula {
    margin-top: var(--space-3);
  }

  .term-formula :global(.formula) {
    border: 0;
    background: var(--color-surface-muted);
    padding: var(--space-3);
  }

  .term-module {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
  }

  .term-module:hover {
    text-decoration: underline;
  }

  .empty-state {
    max-width: 680px;
    margin-top: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 900px) {
    .glossary-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .search-panel {
      grid-template-columns: 1fr;
    }

    .glossary-group {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
