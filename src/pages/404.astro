---
import ButtonLink from '../components/ui/ButtonLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman tidak ditemukan"
  description="Halaman yang Anda cari tidak tersedia di Vector Lab."
>
  <section class="not-found">
    <div class="container not-found-inner">
      <p class="eyebrow">404</p>
      <h1>Halaman tidak ditemukan.</h1>
      <p class="lede">
        Alamat yang Anda buka tidak tersedia. Anda dapat kembali ke beranda atau meninjau
        kurikulum vektor.
      </p>
      <div class="not-found-actions">
        <ButtonLink href="/">Kembali ke beranda</ButtonLink>
        <ButtonLink href="/materi" variant="secondary">Lihat kurikulum</ButtonLink>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(72px, 12vw, 160px);
  }

  .not-found-inner {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: 720px;
  }

  .not-found h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.04em;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>
