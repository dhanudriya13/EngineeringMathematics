---
import SectionHeading from '../ui/SectionHeading.astro';

const steps = [
  {
    number: '01',
    title: 'Konsep',
    description:
      'Mulai dari makna dan representasi geometris. Vektor diperkenalkan sebagai objek yang memiliki besar dan arah, bukan sekadar deretan angka.',
  },
  {
    number: '02',
    title: 'Matematika',
    description:
      'Pelajari definisi, notasi, dan langkah perhitungan. Setiap simbol dijelaskan agar rumus dapat dibaca dan digunakan dengan benar.',
  },
  {
    number: '03',
    title: 'Aplikasi',
    description:
      'Hubungkan konsep dengan grafika komputer, pengembangan gim, ilmu data, dan bidang teknik melalui contoh yang bermakna.',
  },
];
---

<section class="learning-path">
  <div class="container">
    <SectionHeading
      eyebrow="Pendekatan belajar"
      title="Konsep dulu, matematika kedua, aplikasi ketiga."
      description="Urutan ini membantu mahasiswa membangun pemahaman yang utuh sebelum berlatih perhitungan dan menerapkannya pada masalah komputasi."
    />

    <ol class="steps">
      {
        steps.map((step) => (
          <li class="step">
            <span class="step-number" aria-hidden="true">
              {step.number}
            </span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .learning-path {
    padding-block: var(--section-space);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-12);
    list-style: none;
  }

  .step {
    position: relative;
    padding-top: var(--space-5);
    border-top: 2px solid var(--color-primary);
  }

  .step-number {
    display: block;
    margin-bottom: var(--space-4);
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .step h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .step p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      margin-top: var(--space-8);
    }
  }
</style>
