---
import { getArea } from '../../data/areas';
import Badge from '../ui/Badge.astro';

const area = getArea('playground');

if (!area) {
  throw new Error('Data area playground tidak ditemukan.');
}
---

<section class="playground-preview">
  <div class="container playground-grid">
    <div class="playground-copy">
      <p class="eyebrow">Laboratorium interaktif</p>
      <h2>Ruang eksperimen untuk melihat matematika bekerja.</h2>
      <p class="lede">
        Playground memungkinkan setiap perubahan nilai vektor langsung memperlihatkan hasil
        geometris, perhitungan komponen, dan rumus yang digunakan.
      </p>
      <div class="playground-status">
        <Badge variant="accent">{area.phase}</Badge>
        <p>{area.status}</p>
      </div>
      <a class="section-link" href="/playground">Buka Playground <span aria-hidden="true">→</span></a>
    </div>

    <ul class="tool-list">
      {
        area.capabilities.map((capability) => (
          <li>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .playground-preview {
    padding-block: var(--section-space);
  }

  .playground-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }

  .playground-copy {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    position: sticky;
    top: calc(var(--header-height) + 32px);
  }

  .playground-copy h2 {
    max-width: 520px;
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    letter-spacing: -0.03em;
  }

  .playground-status {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid #bfdbfe;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
  }

  .playground-status p {
    color: var(--color-primary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .section-link {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 650;
    text-decoration: none;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  .tool-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    list-style: none;
  }

  .tool-list li {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .tool-list h3 {
    margin-bottom: 6px;
    font-size: var(--text-base);
    letter-spacing: 0;
  }

  .tool-list p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  @media (max-width: 900px) {
    .playground-grid {
      grid-template-columns: 1fr;
    }

    .playground-copy {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .tool-list {
      grid-template-columns: 1fr;
    }
  }
</style>
