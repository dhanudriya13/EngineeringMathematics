---
import type { ModuleSummary } from '../../types';

interface Props {
  previous: ModuleSummary | null;
  next: ModuleSummary | null;
}

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav class="module-pager" aria-label="Navigasi antar modul">
      {previous ? (
        <a class="pager-link pager-link--previous" href={`/materi/${previous.id}`}>
          <span class="pager-label">← Modul sebelumnya</span>
          <span class="pager-title">{previous.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a class="pager-link pager-link--next" href={`/materi/${next.id}`}>
          <span class="pager-label">Modul berikutnya →</span>
          <span class="pager-title">{next.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .module-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .pager-link {
    display: grid;
    gap: 3px;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .pager-link:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-text);
  }

  .pager-link--next {
    text-align: right;
  }

  .pager-label {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .pager-title {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  @media (max-width: 620px) {
    .module-pager {
      grid-template-columns: 1fr;
    }

    .pager-link--next {
      text-align: left;
    }
  }
</style>
