---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class="brand" class:list={{ 'brand--compact': compact }}>
  <svg
    class="brand-mark"
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M5 27V4M5 27H29" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <path
      d="M5 27 24 8"
      stroke="var(--color-accent)"
      stroke-width="2.2"
      stroke-linecap="round"
    />
    <path
      d="m18.5 8 5.5 0 0 5.5"
      stroke="var(--color-accent)"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx="5" cy="27" r="2" fill="var(--color-primary)" />
  </svg>
  <span class="brand-copy">
    <span class="brand-name">Vector <span class="brand-name-accent">Lab</span></span>
    {!compact && <span class="brand-subtitle">Matematika Teknik</span>}
  </span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-primary);
  }

  .brand-mark {
    width: 30px;
    height: 30px;
    flex: none;
    color: var(--color-primary);
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-name {
    font-size: 1.08rem;
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  .brand-name-accent {
    color: var(--color-accent-strong);
  }

  .brand-subtitle {
    margin-top: 4px;
    color: var(--color-text-secondary);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .brand--compact .brand-mark {
    width: 28px;
    height: 28px;
  }
</style>
